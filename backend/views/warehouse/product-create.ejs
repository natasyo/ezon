<!DOCTYPE html>
<html lang="ru">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col">
    <%- include('../partials/header') %>

    <main class="flex-1 max-w-2xl mx-auto px-4 py-6 w-full">
      <a
        href="/warehouse/products"
        class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block"
        >← Каталог</a
      >
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Новый товар</h2>

      <!-- Блок с общей ошибкой (не привязанной к конкретному полю) -->
      <% if (flash && flash.error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-4 mb-4">
          <%= flash.error %>
        </div>
      <% } %>

      <form
        action="/warehouse/products"
        method="POST"
        enctype="multipart/form-data"
        novalidate
        class="bg-white shadow rounded-lg p-6 space-y-4"
        name="create-product"
      >
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">SKU *</label>
            <input
              type="text"
              name="sku"
              required
              value="<%= flash && flash.old && flash.old.sku ? flash.old.sku : '' %>"
              class="w-full border rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none <%= flash && flash.errors && flash.errors.sku ? 'border-red-400 bg-red-50' : 'border-gray-300' %>"
            />
            <% if (flash && flash.errors && flash.errors.sku) { %>
              <p class="text-red-500 text-xs mt-1"><%= flash.errors.sku %></p>
            <% } %>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1"
              >Наименование *</label
            >
            <input
              type="text"
              name="name"
              required
              value="<%= flash && flash.old && flash.old.name ? flash.old.name : '' %>"
              class="w-full border rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none <%= flash && flash.errors && flash.errors.name ? 'border-red-400 bg-red-50' : 'border-gray-300' %>"
            />
            <% if (flash && flash.errors && flash.errors.name) { %>
              <p class="text-red-500 text-xs mt-1"><%= flash.errors.name %></p>
            <% } %>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">EAN</label>
            <input
              type="text"
              name="ean"
              value="<%= flash && flash.old && flash.old.ean ? flash.old.ean : '' %>"
              class="w-full border rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none <%= flash && flash.errors && flash.errors.ean ? 'border-red-400 bg-red-50' : 'border-gray-300' %>"
            />
            <% if (flash && flash.errors && flash.errors.ean) { %>
              <p class="text-red-500 text-xs mt-1"><%= flash.errors.ean %></p>
            <% } %>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">ASIN</label>
            <input
              type="text"
              name="asin"
              value="<%= flash && flash.old && flash.old.asin ? flash.old.asin : '' %>"
              class="w-full border rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none <%= flash && flash.errors && flash.errors.asin ? 'border-red-400 bg-red-50' : 'border-gray-300' %>"
            />
            <% if (flash && flash.errors && flash.errors.asin) { %>
              <p class="text-red-500 text-xs mt-1"><%= flash.errors.asin %></p>
            <% } %>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Категория</label>
            <select
              name="categoryId"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            >
              <option value="">— Без категории —</option>
              <% (categories || []).forEach(function(c) { %>
                <option value="<%= c.id %>" <%= flash && flash.old && flash.old.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Состояние</label>
            <select
              name="condition"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            >
              <option value="">— Не указано —</option>
              <% ['Новый', 'Бракованный', 'Б/у'].forEach(function(cond) { %>
                <option value="<%= cond %>" <%= flash && flash.old && flash.old.condition === cond ? 'selected' : '' %>><%= cond %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1"
              >Цена поступления</label
            >
            <input
              type="text"
              inputmode="decimal"
              name="purchasePrice"
              value="<%= flash && flash.old && flash.old.purchasePrice !== undefined ? flash.old.purchasePrice : '0' %>"
              pattern="^[0-9]*[.,]?[0-9]*$"
              title="Введите число (допускаются цифры, запятая или точка)"
              oninput="formatDecimalInput(this)"
              class="w-full border rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none <%= flash && flash.errors && flash.errors.purchasePrice ? 'border-red-400 bg-red-50' : 'border-gray-300' %>"
            />
            <% if (flash && flash.errors && flash.errors.purchasePrice) { %>
              <p class="text-red-500 text-xs mt-1"><%= flash.errors.purchasePrice %></p>
            <% } %>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Цена продажи</label>
            <input
              type="text"
              inputmode="decimal"
              name="salePrice"
              value="<%= flash && flash.old && flash.old.salePrice !== undefined ? flash.old.salePrice : '0' %>"
              pattern="^[0-9]*[.,]?[0-9]*$"
              title="Введите число (допускаются цифры, запятая или точка)"
              oninput="formatDecimalInput(this)"
              class="w-full border rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none <%= flash && flash.errors && flash.errors.salePrice ? 'border-red-400 bg-red-50' : 'border-gray-300' %>"
            />
            <% if (flash && flash.errors && flash.errors.salePrice) { %>
              <p class="text-red-500 text-xs mt-1"><%= flash.errors.salePrice %></p>
            <% } %>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Ячейка</label>
            <select
              name="cellId"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            >
              <option value="">— Без ячейки —</option>
              <% (cells || []).forEach(function(c) { %>
                <option value="<%= c.id %>" <%= flash && flash.old && flash.old.cellId === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1"
              >Дата поступления</label
            >
            <input
              type="date"
              name="arrivalDate"
              value="<%= flash && flash.old && flash.old.arrivalDate ? flash.old.arrivalDate : '' %>"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
        </div>

        <!-- Загрузка фото -->
        <div>
          <label class="block text-sm text-gray-600 mb-1"
            >Фотографии (до 10 шт.)</label
          >
          <input
            type="file"
            name="photos"
            multiple
            accept="image/*"
            class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
          />
          <p class="text-xs text-gray-400 mt-1">
            Можно выбрать несколько файлов. Загружаются сразу при создании.
          </p>
        </div>

        <button
          type="submit"
          id="create-product-submit"
          name="create-product-submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-6 rounded-lg transition-colors"
        >
          Создать товар
        </button>
      </form>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/form-validate') %>
    <script>
      function formatDecimalInput(input) {
        // 1. Заменяем запятые на точки, удаляем всё кроме цифр и точек
        let v = input.value.replace(/,/g, '.').replace(/[^0-9.]/g, '');
        
        // 2. Разрешаем только одну (первую) точку
        let p = v.indexOf('.');
        if (p !== -1) {
            v = v.slice(0, p + 1) + v.slice(p + 1).replace(/\./g, '');
        }
        
        // 3. Убираем ведущий ноль перед другими цифрами (05 -> 5), но сохраняем для дробей (0.5)
        v = v.replace(/^0([0-9])/g, '$1');
        
        // 4. Если строка пустая — ставим 0
        input.value = v === '' ? '0' : v;
    }

    </script>
  </body>
</html>
