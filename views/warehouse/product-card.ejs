<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-3xl mx-auto px-4 py-6 w-full">

    <a href="/warehouse/products" class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">← Каталог</a>

    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
      <!-- Заголовок -->
      <div class="px-6 py-5 border-b flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-gray-900"><%= product.name %></h2>
          <p class="text-sm text-gray-500 mt-1">SKU: <%= product.sku %> | ID: <%= product.id %></p>
          <% if (product.createdBy) { %>
            <p class="text-xs text-gray-400 mt-0.5">
              Создал: <%= product.createdBy.displayName || product.createdBy.userName %>
            </p>
          <% } %>
        </div>
        <span class="inline-block bg-blue-50 text-blue-700 text-sm font-medium px-3 py-1 rounded">
          <%= locals.statusLabel(product.status) %>
        </span>
      </div>

      <!-- Поля карточки -->
      <div class="px-6 py-4 grid grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-500">EAN</span>
          <p class="text-gray-900"><%= product.ean || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">ASIN</span>
          <p class="text-gray-900"><%= product.asin || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Категория</span>
          <p class="text-gray-900"><%= product.category?.name || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Состояние</span>
          <p class="text-gray-900"><%= product.condition || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Цена поступления</span>
          <p class="text-gray-900" data-testid="purchase-price"><%= Number(product.purchasePrice).toLocaleString() %> ₽</p>
        </div>
        <div>
          <span class="text-gray-500">Цена продажи</span>
          <p class="text-gray-900 text-green-700 font-medium" data-testid="sale-price"><%= Number(product.salePrice).toLocaleString() %> ₽</p>
        </div>
        <div>
          <span class="text-gray-500">Ячейка хранения</span>
          <p class="text-gray-900"><%= product.cell?.name || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Дата поступления</span>
          <p class="text-gray-900"><%= product.arrivalDate ? new Date(product.arrivalDate).toLocaleDateString('ru') : '—' %></p>
        </div>
      </div>

      <!-- Витрины -->
      <div class="px-6 py-4 border-t">
        <span class="text-gray-500 text-sm">Статусы на витринах</span>
        <div class="mt-2 flex gap-3 flex-wrap">
          <% var showcases = typeof product.showcaseStatuses === 'string'
                ? JSON.parse(product.showcaseStatuses) : product.showcaseStatuses || {}; %>
          <% Object.keys(showcases).forEach(function(key) { %>
            <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">
              <%= key %>: <%= showcases[key] === 'VISIBLE' ? '🟢' : '⚫' %>
            </span>
          <% }); %>
          <% if (Object.keys(showcases).length === 0) { %>
            <span class="text-gray-400 text-xs">не назначены</span>
          <% } %>
        </div>
      </div>

      <!-- Доп. поля (JSON) -->
      <% var custom = typeof product.customFields === 'string'
            ? JSON.parse(product.customFields) : product.customFields || {}; %>
      <% if (Object.keys(custom).length > 0) { %>
        <div class="px-6 py-4 border-t">
          <span class="text-gray-500 text-sm">Дополнительные поля</span>
          <div class="mt-2 grid grid-cols-2 gap-2 text-sm">
            <% Object.keys(custom).forEach(function(key) { %>
              <div>
                <span class="text-gray-500"><%= key %></span>
                <p class="text-gray-900"><%= custom[key] %></p>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- Фотографии -->
      <% if ((product.images || []).length > 0) { %>
      <div class="px-6 py-4 border-t">
        <span class="text-gray-500 text-sm">Фотографии (<%= product.images.length %> шт.)</span>
        <div class="mt-3 grid grid-cols-4 sm:grid-cols-5 gap-3" id="gallery">
          <% product.images.forEach(function(img, idx) { %>
            <div class="group relative cursor-pointer" data-index="<%= idx %>" onclick="openLightbox(<%= idx %>)">
              <div class="aspect-square rounded-lg overflow-hidden border border-gray-200 hover:border-blue-400 transition-colors bg-gray-100">
                <img src="<%= img %>" alt="Фото <%= idx + 1 %>"
                     loading="lazy"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                     onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2280%22 height=%2280%22><rect fill=%22%23f0f0f0%22 width=%2280%22 height=%2280%22/><text x=%2220%22 y=%2250%22 fill=%22%23999%22 font-size=%2212%22>нет фото</text></svg>'" />
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                  <span class="opacity-0 group-hover:opacity-100 text-white text-2xl drop-shadow-lg transition-opacity">🔍</span>
                </div>
              </div>
              <!-- Кнопка удаления фото -->
              <form action="/warehouse/products/delete-photo" method="POST" class="absolute top-1 right-1 z-10" onclick="event.stopPropagation()">
                <input type="hidden" name="productId" value="<%= product.id %>" />
                <input type="hidden" name="imageUrl" value="<%= img %>" />
                <button type="submit"
                        onclick="return confirm('Удалить это фото?')"
                        class="bg-red-500 hover:bg-red-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center opacity-70 hover:opacity-100 transition-opacity"
                        title="Удалить фото">
                  ×
                </button>
              </form>
            </div>
          <% }); %>
        </div>
      </div>
      <% } else { %>
      <div class="px-6 py-4 border-t">
        <span class="text-gray-500 text-sm">Фотографии</span>
        <p class="text-gray-400 text-xs mt-1">нет</p>
      </div>
      <% } %>
    </div>

    <!-- Редактирование -->
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
      <div class="px-6 py-4 border-b">
        <h3 class="font-semibold text-gray-800">Редактировать</h3>
      </div>
      <form action="/warehouse/products/<%= product.id %>" method="POST" enctype="multipart/form-data" novalidate data-validate="1" class="px-6 py-4 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">Наименование</label>
            <input type="text" name="name" value="<%= product.name %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Категория</label>
            <input type="text" name="categoryId" value="<%= product.categoryId || product.category?.id || '' %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Состояние</label>
            <input type="text" name="condition" value="<%= product.condition || '' %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Ячейка</label>
                        <input type="text" name="cellId" value="<%= product.cellId || '' %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Цена поступления</label>
            <input type="text" inputmode="decimal" name="purchasePrice" value="<%= product.purchasePrice %>"
              pattern="^[0-9]*[.,]?[0-9]*$" title="Введите число (допускаются цифры, запятая или точка)"
              oninput="this.value = this.value.replace(/[^0-9.,]/g, '')"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Цена продажи</label>
            <input type="text" inputmode="decimal" name="salePrice" value="<%= product.salePrice %>"
              pattern="^[0-9]*[.,]?[0-9]*$" title="Введите число (допускаются цифры, запятая или точка)"
              oninput="this.value = this.value.replace(/[^0-9.,]/g, '')"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
        </div>

        <!-- Загрузка новых фото при редактировании -->
        <div>
          <label class="block text-sm text-gray-600 mb-1">Добавить фото (до 10 шт.)</label>
          <input
            type="file"
            name="photos"
            multiple
            accept="image/*"
            class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
          />
          <p class="text-xs text-gray-400 mt-1">Новые фото добавятся к уже существующим.</p>
        </div>

        <button type="submit" id="edit-product-submit" name="edit-product-submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-6 rounded-lg transition-colors">
          Сохранить
        </button>
      </form>
    </div>

    <!-- Смена статуса -->
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
      <div class="px-6 py-4 border-b">
        <h3 class="font-semibold text-gray-800">Смена статуса</h3>
        <p class="text-sm text-gray-500 mt-1">
          Текущий: <strong><%= locals.statusLabel(product.status) %></strong>
        </p>
      </div>
      <div class="px-6 py-4 flex gap-3 flex-wrap">
        <% transitions.forEach(function(nextStatus) { %>
          <form action="/warehouse/products/<%= product.id %>/transition" method="POST" novalidate style="display:inline">
            <button type="submit" name="transition-status" class="transition-btn bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-2 px-4 rounded-lg transition-colors border border-gray-300">
              → <%= locals.statusLabel(nextStatus) %>
            </button>
          </form>
        <% }); %>
        <% if (transitions.length === 0) { %>
          <span class="text-gray-400 text-sm">Доступных переходов нет</span>
        <% } %>
      </div>
    </div>

  </main>

  <%- include('../partials/footer') %>

  <%- include('../partials/form-validate') %>

  <!-- ===== Лайтбокс (галерея) ===== -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/95 flex items-center justify-center" onclick="closeLightbox(event)">
    <!-- Кнопка закрытия -->
    <button class="absolute top-4 right-4 text-white/70 hover:text-white text-3xl leading-none z-10 w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors"
            onclick="closeLightbox()" title="Закрыть (Esc)">
      ×
    </button>

    <!-- Счётчик -->
    <div id="lightbox-counter" class="absolute top-4 left-4 text-white/70 text-sm z-10"></div>

    <!-- Стрелка влево -->
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl leading-none z-10 w-12 h-12 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors"
            onclick="event.stopPropagation(); navigateLightbox(-1)" title="Предыдущее (←)">
      ‹
    </button>

    <!-- Контейнер изображения -->
    <div id="lightbox-img-wrapper" class="max-w-[90vw] max-h-[90vh] flex items-center justify-center">
      <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl" />
    </div>

    <!-- Стрелка вправо -->
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl leading-none z-10 w-12 h-12 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors"
            onclick="event.stopPropagation(); navigateLightbox(1)" title="Следующее (→)">
      ›
    </button>
  </div>

  <script>
    // Собираем все URL изображений из галереи
    var galleryImages = [];
    var galleryContainer = document.getElementById('gallery');
    if (galleryContainer) {
      var imgs = galleryContainer.querySelectorAll('img');
      imgs.forEach(function(img) {
        if (img.src && !img.src.startsWith('data:')) {
          galleryImages.push(img.src);
        }
      });
    }

    var currentIndex = 0;
    var lightbox = document.getElementById('lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    var lightboxCounter = document.getElementById('lightbox-counter');

    function openLightbox(index) {
      if (galleryImages.length === 0) return;
      currentIndex = index;
      showImage();
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox(e) {
      // Закрываем только при клике на фон (не на изображение или кнопки)
      if (e && e.target !== lightbox) return;
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function navigateLightbox(delta) {
      if (galleryImages.length === 0) return;
      currentIndex = (currentIndex + delta + galleryImages.length) % galleryImages.length;
      showImage();
    }

    function showImage() {
      lightboxImg.src = galleryImages[currentIndex];
      lightboxImg.alt = 'Фото ' + (currentIndex + 1);
      lightboxCounter.textContent = (currentIndex + 1) + ' / ' + galleryImages.length;
    }

    // Клавиатура
    document.addEventListener('keydown', function(e) {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigateLightbox(-1);
      if (e.key === 'ArrowRight') navigateLightbox(1);
    });

    // Свайпы на мобильных
    var touchStartX = 0;
    lightbox.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
    });
    lightbox.addEventListener('touchend', function(e) {
      var delta = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 50) {
        navigateLightbox(delta < 0 ? 1 : -1);
      }
    });
  </script>

</body>
</html>
