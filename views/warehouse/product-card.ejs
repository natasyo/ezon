<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-3xl mx-auto px-4 py-6 w-full">

    <a href="/warehouse/products" class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">← Каталог</a>

    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
      <!-- Заголовок -->
      <div class="px-6 py-5 border-b flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-gray-900"><%= product.name %></h2>
          <p class="text-sm text-gray-500 mt-1">SKU: <%= product.sku %> | ID: <%= product.id %></p>
          <% if (product.createdBy) { %>
            <p class="text-xs text-gray-400 mt-0.5">
              Создал: <%= product.createdBy.displayName || product.createdBy.userName %>
            </p>
          <% } %>
        </div>
        <span class="inline-block bg-blue-50 text-blue-700 text-sm font-medium px-3 py-1 rounded">
          <%= locals.statusLabel(product.status) %>
        </span>
      </div>

      <!-- Поля карточки -->
      <div class="px-6 py-4 grid grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-500">EAN</span>
          <p class="text-gray-900"><%= product.ean || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">ASIN</span>
          <p class="text-gray-900"><%= product.asin || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Категория</span>
          <p class="text-gray-900"><%= product.category?.name || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Состояние</span>
          <p class="text-gray-900"><%= product.condition || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Цена поступления</span>
          <p class="text-gray-900"><%= Number(product.purchasePrice).toLocaleString() %> ₽</p>
        </div>
        <div>
          <span class="text-gray-500">Цена продажи</span>
          <p class="text-gray-900 text-green-700 font-medium"><%= Number(product.salePrice).toLocaleString() %> ₽</p>
        </div>
        <div>
          <span class="text-gray-500">Ячейка хранения</span>
          <p class="text-gray-900"><%= product.cell?.name || '—' %></p>
        </div>
        <div>
          <span class="text-gray-500">Дата поступления</span>
          <p class="text-gray-900"><%= product.arrivalDate ? new Date(product.arrivalDate).toLocaleDateString('ru') : '—' %></p>
        </div>
      </div>

      <!-- Витрины -->
      <div class="px-6 py-4 border-t">
        <span class="text-gray-500 text-sm">Статусы на витринах</span>
        <div class="mt-2 flex gap-3 flex-wrap">
          <% var showcases = typeof product.showcaseStatuses === 'string'
                ? JSON.parse(product.showcaseStatuses) : product.showcaseStatuses || {}; %>
          <% Object.keys(showcases).forEach(function(key) { %>
            <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">
              <%= key %>: <%= showcases[key] === 'VISIBLE' ? '🟢' : '⚫' %>
            </span>
          <% }); %>
          <% if (Object.keys(showcases).length === 0) { %>
            <span class="text-gray-400 text-xs">не назначены</span>
          <% } %>
        </div>
      </div>

      <!-- Доп. поля (JSON) -->
      <% var custom = typeof product.customFields === 'string'
            ? JSON.parse(product.customFields) : product.customFields || {}; %>
      <% if (Object.keys(custom).length > 0) { %>
        <div class="px-6 py-4 border-t">
          <span class="text-gray-500 text-sm">Дополнительные поля</span>
          <div class="mt-2 grid grid-cols-2 gap-2 text-sm">
            <% Object.keys(custom).forEach(function(key) { %>
              <div>
                <span class="text-gray-500"><%= key %></span>
                <p class="text-gray-900"><%= custom[key] %></p>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- Фотографии -->
      <div class="px-6 py-4 border-t">
        <span class="text-gray-500 text-sm">Фотографии</span>
        <div class="mt-2 flex gap-2 flex-wrap">
          <% (product.images || []).forEach(function(img) { %>
            <div class="w-20 h-20 bg-gray-100 rounded border flex items-center justify-center text-xs text-gray-400">
              📷
            </div>
          <% }); %>
          <% if ((product.images || []).length === 0) { %>
            <span class="text-gray-400 text-xs">нет</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Редактирование -->
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
      <div class="px-6 py-4 border-b">
        <h3 class="font-semibold text-gray-800">Редактировать</h3>
      </div>
      <form action="/warehouse/products/<%= product.id %>" method="POST" class="px-6 py-4 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">Наименование</label>
            <input type="text" name="name" value="<%= product.name %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Категория</label>
            <input type="text" name="categoryId" value="<%= product.categoryId || product.category?.id || '' %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Состояние</label>
            <input type="text" name="condition" value="<%= product.condition || '' %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Ячейка</label>
                        <input type="text" name="cellId" value="<%= product.cellId || '' %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Цена поступления</label>
            <input type="number" step="0.01" name="purchasePrice" value="<%= product.purchasePrice %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Цена продажи</label>
            <input type="number" step="0.01" name="salePrice" value="<%= product.salePrice %>"
              class="w-full border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          </div>
        </div>
        <button type="submit" id="edit-product-submit" name="edit-product-submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-6 rounded-lg transition-colors">
          Сохранить
        </button>
      </form>
    </div>

    <!-- Смена статуса -->
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
      <div class="px-6 py-4 border-b">
        <h3 class="font-semibold text-gray-800">Смена статуса</h3>
        <p class="text-sm text-gray-500 mt-1">
          Текущий: <strong><%= locals.statusLabel(product.status) %></strong>
        </p>
      </div>
      <div class="px-6 py-4 flex gap-3 flex-wrap">
        <% transitions.forEach(function(nextStatus) { %>
          <form action="/warehouse/products/<%= product.id %>/transition" method="POST" style="display:inline">
            <button type="submit" name="transition-status" class="transition-btn bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-2 px-4 rounded-lg transition-colors border border-gray-300">
              → <%= locals.statusLabel(nextStatus) %>
            </button>
          </form>
        <% }); %>
        <% if (transitions.length === 0) { %>
          <span class="text-gray-400 text-sm">Доступных переходов нет</span>
        <% } %>
      </div>
    </div>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>
