<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-7xl mx-auto px-4 py-8 w-full">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
      <a href="/warehouse/products/create"
         class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition-colors">
        + Новый товар
      </a>
    </div>

    <!-- Поиск и фильтры -->
    <form action="/warehouse/products" method="GET" class="bg-white shadow rounded-lg p-4 mb-6">
      <div class="flex gap-3 mb-3">
        <input type="text" name="search" value="<%= filters.search %>"
          placeholder="Поиск по наименованию..."
          class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
        <button type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-6 py-2 rounded-lg transition-colors">
          Найти
        </button>
        <a href="/warehouse/products"
          class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors">
          Сбросить
        </a>
      </div>

      <details class="group">
        <summary class="text-sm text-gray-500 cursor-pointer hover:text-gray-700 select-none">
          Фильтры ▾
        </summary>
        <div class="grid grid-cols-4 gap-3 mt-3 pt-3 border-t">
          <div>
            <label class="block text-xs text-gray-500 mb-1">SKU</label>
            <input type="text" name="sku" value="<%= filters.sku %>"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">EAN</label>
            <input type="text" name="ean" value="<%= filters.ean %>"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">ASIN</label>
            <input type="text" name="asin" value="<%= filters.asin %>"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Состояние</label>
            <input type="text" name="condition" value="<%= filters.condition %>"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Статус</label>
            <select name="status"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none">
              <option value="">Все</option>
              <% statuses.forEach(function(s) { %>
                <option value="<%= s.value %>" <%= filters.status === s.value ? 'selected' : '' %>><%= s.label %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Ячейка</label>
            <input type="text" name="cellId" value="<%= filters.cell %>"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Категория (ID)</label>
            <input type="text" name="categoryId" value="<%= filters.categoryId %>"
              class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" />
          </div>
        </div>
      </details>
    </form>

    <!-- Результаты -->
    <div class="flex items-center justify-between mb-3 text-sm text-gray-500">
      <span>Найдено: <%= total %></span>
      <span id="selection-count" class="hidden text-blue-600 font-medium">Выбрано: 0</span>
      <% if (total > 0) { %>
        <span>Стр. <%= page %> из <%= Math.ceil(total / 50) %></span>
      <% } %>
    </div>

    <!-- Массовые действия -->
    <form id="bulk-form" action="/warehouse/products/bulk" method="POST"
          class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-3 hidden"
          onsubmit="return prepareBulkSubmit()">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-sm text-blue-700 font-medium">Массовое действие:</span>
        <input type="number" step="0.01" name="price" placeholder="Цена"
          class="border border-gray-300 rounded px-2 py-1 text-sm w-28 focus:ring-1 focus:ring-blue-500 outline-none" />
        <select name="status"
          class="border border-gray-300 rounded px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500 outline-none">
          <option value="">Статус</option>
          <% statuses.forEach(function(s) { %>
            <option value="<%= s.value %>"><%= s.label %></option>
          <% }); %>
        </select>
        <input type="text" name="cellId" placeholder="Ячейка"
          class="border border-gray-300 rounded px-2 py-1 text-sm w-28 focus:ring-1 focus:ring-blue-500 outline-none" />
        <input type="text" name="categoryId" placeholder="Категория ID"
          class="border border-gray-300 rounded px-2 py-1 text-sm w-36 focus:ring-1 focus:ring-blue-500 outline-none" />
        <button type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-1 rounded transition-colors">
          Применить
        </button>
      </div>
    </form>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="w-10 px-4 py-3">
              <input type="checkbox" id="select-all" onchange="toggleAll(this)" class="rounded" />
            </th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">SKU</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Наименование</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Категория</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Цена продажи</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Статус</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Ячейка</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(function(p) { %>
            <tr class="border-b hover:bg-gray-50">
              <td class="px-4 py-2" onclick="event.stopPropagation()">
                <input type="checkbox" name="ids[]" value="<%= p.id %>" class="item-checkbox rounded"
                       onchange="updateSelection()" />
              </td>
              <td class="px-4 py-2 text-gray-700"><%= p.sku %></td>
              <td class="px-4 py-2 text-gray-900 font-medium cursor-pointer"
                  onclick="location.href='/warehouse/products/<%= p.id %>'"><%= p.name %></td>
              <td class="px-4 py-2 text-gray-500 cursor-pointer"
                  onclick="location.href='/warehouse/products/<%= p.id %>'"><%= p.category?.name || '—' %></td>
              <td class="px-4 py-2 text-green-700 cursor-pointer"
                  onclick="location.href='/warehouse/products/<%= p.id %>'"><%= Number(p.salePrice).toLocaleString() %> ₽</td>
              <td class="px-4 py-2 cursor-pointer" onclick="location.href='/warehouse/products/<%= p.id %>'">
                <span class="inline-block bg-blue-50 text-blue-700 text-xs font-medium px-2 py-0.5 rounded">
                  <%= locals.statusLabels(p.status) %>
                </span>
              </td>
              <td class="px-4 py-2 text-gray-500 cursor-pointer"
                  onclick="location.href='/warehouse/products/<%= p.id %>'"><%= p.cell?.name || '—' %></td>
            </tr>
          <% }); %>
          <% if (data.length === 0) { %>
            <tr>
              <td colspan="6" class="px-4 py-12 text-center text-gray-400">Ничего не найдено</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Пагинация -->
    <% var totalPages = Math.ceil(total / 50); %>
    <% if (totalPages > 1) { %>
      <div class="mt-4 flex justify-center gap-2">
        <% for (var i = 1; i <= totalPages; i++) { %>
          <% if (i === page) { %>
            <span class="px-3 py-1 bg-blue-600 text-white text-sm rounded"><%= i %></span>
          <% } else { %>
            <a href="/warehouse/products?<%= Object.entries(filters).filter(([k,v]) => v).map(([k,v]) => k+'='+encodeURIComponent(v)).join('&') %>&page=<%= i %>"
               class="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm rounded"><%= i %></a>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

<script>
function updateSelection() {
  var checked = document.querySelectorAll('.item-checkbox:checked');
  var count = document.getElementById('selection-count');
  var form = document.getElementById('bulk-form');
  var all = document.getElementById('select-all');

  if (checked.length > 0) {
    count.textContent = 'Выбрано: ' + checked.length;
    count.classList.remove('hidden');
    form.classList.remove('hidden');
  } else {
    count.classList.add('hidden');
    form.classList.add('hidden');
  }

  var total = document.querySelectorAll('.item-checkbox');
  all.checked = checked.length === total.length;
}

function toggleAll(el) {
  document.querySelectorAll('.item-checkbox').forEach(function(cb) {
    cb.checked = el.checked;
  });
  updateSelection();
}

function prepareBulkSubmit() {
  var checked = document.querySelectorAll('.item-checkbox:checked');
  if (checked.length === 0) return false;
  return confirm('Применить к ' + checked.length + ' товарам?');
}
</script>

</body>
</html>
