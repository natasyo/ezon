<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-7xl mx-auto px-4 py-8 w-full">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
      <a href="/warehouse/products/create"
         class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition-colors">
        + Новый товар
      </a>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600">ID</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">SKU</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Наименование</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Категория</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Статус</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Ячейка</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(function(p) { %>
            <tr class="border-b hover:bg-gray-50 cursor-pointer"
                onclick="location.href='/warehouse/products/<%= p.id %>'">
              <td class="px-4 py-2 text-gray-700"><%= p.id %></td>
              <td class="px-4 py-2 text-gray-700"><%= p.sku %></td>
              <td class="px-4 py-2 text-gray-900 font-medium"><%= p.name %></td>
              <td class="px-4 py-2 text-gray-500"><%= p.category?.name || '—' %></td>
              <td class="px-4 py-2">
                <span class="inline-block bg-blue-50 text-blue-700 text-xs font-medium px-2 py-0.5 rounded">
                  <%= locals.statusLabels(p.status) %>
                </span>
              </td>
              <td class="px-4 py-2 text-gray-500"><%= p.cell || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (page < total / 50) { %>
      <div class="mt-4 text-center">
        <a href="/warehouse/products?page=<%= page + 1 %>"
           class="text-blue-600 hover:text-blue-800 text-sm">Следующая страница →</a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
