<!DOCTYPE html>
<html lang="ru">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col">
    <%- include('../partials/header') %>

    <main class="flex-1 max-w-2xl mx-auto px-4 py-6 w-full">
      <a
        href="/warehouse/products"
        class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block"
        >← Каталог</a
      >
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Новый товар</h2>

      <form
        action="/warehouse/products"
        method="POST"
        class="bg-white shadow rounded-lg p-6 space-y-4"
      >
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">SKU *</label>
            <input
              type="text"
              name="sku"
              required
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1"
              >Наименование *</label
            >
            <input
              type="text"
              name="name"
              required
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">EAN</label>
            <input
              type="text"
              name="ean"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">ASIN</label>
            <input
              type="text"
              name="asin"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Категория</label>
            <input
              type="text"
              name="categoryId"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Состояние</label>
            <input
              type="text"
              name="condition"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1"
              >Цена поступления</label
            >
            <input
              type="number"
              step="0.01"
              name="purchasePrice"
              value="0"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Цена продажи</label>
            <input
              type="number"
              step="0.01"
              name="salePrice"
              value="0"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Ячейка</label>
            <input
              type="text"
              name="cellId"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1"
              >Дата поступления</label
            >
            <input
              type="date"
              name="arrivalDate"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
            />
          </div>
        </div>
        <button
          type="submit"
          id="create-product-submit"
          name="create-product-submit"
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-6 rounded-lg transition-colors"
        >
          Создать товар
        </button>
      </form>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
