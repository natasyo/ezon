<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 w-full">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
      <a href="/warehouse/categories/create"
         class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition-colors">
        + Новая категория
      </a>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Название</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Товаров</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Действия</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(function(cat) { %>
            <tr class="border-b">
              <td class="px-4 py-2 text-gray-900 font-medium"><%= cat.name %></td>
              <td class="px-4 py-2 text-gray-500"><%= cat._count?.products || 0 %></td>
              <td class="px-4 py-2 text-right">
                <a href="/warehouse/categories/<%= cat.id %>/edit"
                   class="text-blue-600 hover:text-blue-800 text-xs mr-3">Редактировать</a>
                <form action="/warehouse/categories/<%= cat.id %>/delete" method="POST" class="inline m-0"
                      onsubmit="return confirm('Удалить категорию «<%= cat.name %>»?')">
                  <button type="submit" name="delete-category" class="delete-btn text-red-500 hover:text-red-700 text-xs">Удалить</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (categories.length === 0) { %>
            <tr>
              <td colspan="3" class="px-4 py-8 text-center text-gray-400">Категорий пока нет</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
