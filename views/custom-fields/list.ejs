<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-4xl mx-auto px-4 py-8 w-full">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
      <a href="/warehouse/custom-fields/create"
         class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition-colors">
        + Новое поле
      </a>
    </div>

    <% if (configs.length === 0) { %>
      <div class="bg-white shadow rounded-lg p-8 text-center text-gray-400">Полей пока нет</div>
    <% } else { %>
      <%
        const grouped = {};
        configs.forEach(function(cfg) {
          const catName = cfg.category ? cfg.category.name : 'Без категории';
          if (!grouped[catName]) grouped[catName] = [];
          grouped[catName].push(cfg);
        });
      %>
      <% Object.keys(grouped).sort().forEach(function(catName) { %>
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-gray-700 mb-3"><%= catName %></h3>
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 border-b">
                <tr>
                  <th class="text-left px-4 py-3 font-medium text-gray-600">Ключ</th>
                  <th class="text-left px-4 py-3 font-medium text-gray-600">Метка</th>
                  <th class="text-left px-4 py-3 font-medium text-gray-600">Тип</th>
                  <th class="text-right px-4 py-3 font-medium text-gray-600">Действия</th>
                </tr>
              </thead>
              <tbody>
                <% grouped[catName].forEach(function(cfg) { %>
                  <tr class="border-b">
                    <td class="px-4 py-2 text-gray-900 font-mono text-xs"><%= cfg.key %></td>
                    <td class="px-4 py-2 text-gray-900"><%= cfg.label %></td>
                    <td class="px-4 py-2 text-gray-500"><%= cfg.type %></td>
                    <td class="px-4 py-2 text-right">
                      <a href="/warehouse/custom-fields/<%= cfg.id %>/edit"
                         class="text-blue-600 hover:text-blue-800 text-xs mr-3">Редактировать</a>
                      <form action="/warehouse/custom-fields/<%= cfg.id %>/delete" method="POST" novalidate class="inline m-0"
                            onsubmit="return confirm('Удалить поле «<%= cfg.label %>»?')">
                        <button type="submit" name="delete-field" class="delete-btn text-red-500 hover:text-red-700 text-xs">Удалить</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% }); %>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
