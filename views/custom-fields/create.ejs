<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-md mx-auto px-4 py-12 w-full">
    <a href="/warehouse/custom-fields" class="text-blue-600 hover:text-blue-800 text-sm mb-4 inline-block">← Поля</a>
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Новое поле</h2>

    <form action="/warehouse/custom-fields" method="POST" novalidate data-validate="1" class="bg-white shadow rounded-lg p-6 space-y-4">
      <div>
        <label for="key" class="block text-sm font-medium text-gray-700 mb-1">Ключ *</label>
        <input type="text" id="key" name="key" required minlength="1"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          placeholder="color"
        />
      </div>
      <div>
        <label for="label" class="block text-sm font-medium text-gray-700 mb-1">Метка *</label>
        <input type="text" id="label" name="label" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          placeholder="Цвет"
        />
      </div>
      <div>
        <label for="type" class="block text-sm font-medium text-gray-700 mb-1">Тип *</label>
        <select id="type" name="type" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white">
          <option value="text">Текст</option>
          <option value="number">Число</option>
          <option value="date">Дата</option>
        </select>
      </div>
      <div>
        <label for="categoryId" class="block text-sm font-medium text-gray-700 mb-1">Категория *</label>
        <select id="categoryId" name="categoryId" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white">
          <option value="">— Выберите —</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>"><%= cat.name %></option>
          <% }); %>
        </select>
      </div>
      <button type="submit" id="create-field-submit" name="create-field-submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 rounded-lg transition-colors">
        Создать
      </button>
    </form>
  </main>

  <%- include('../partials/footer') %>

  <%- include('../partials/form-validate') %>

</body>
</html>
