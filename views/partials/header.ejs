<header class="bg-white shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between container">
    <a href="/" class="text-xl font-bold text-gray-800 no-underline">📦 Ezon</a>
    <nav class="flex gap-4 items-center">
      <a href="/" class="text-gray-600 hover:text-gray-800 font-medium text-sm no-underline">Главная</a>
      <a href="/warehouse/catalog" class="text-gray-600 hover:text-gray-800 font-medium text-sm no-underline">Каталог</a>
      <% if (locals.user) { %>
        <span class="text-sm text-gray-500"><%= locals.user.displayName || locals.user.userName %></span>
        <a href="/auth/logout" class="text-red-500 hover:text-red-700 font-medium text-sm no-underline">Выйти</a>
      <% } else { %>
        <a href="/auth/login" class="text-blue-600 hover:text-blue-800 font-medium text-sm no-underline">Войти</a>
      <% } %>
    </nav>
  </div>
</header>
