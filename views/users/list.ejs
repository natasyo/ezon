<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800"><%= title %></h2>
      <a href="/warehouse/users/create"
         class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition-colors no-underline">
        + Добавить сотрудника
      </a>
    </div>

    <% if (locals.success) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
        <%= success %>
      </div>
    <% } %>

    <!-- Поиск -->
    <form method="GET" action="/warehouse/users" novalidate data-validate="0" class="mb-4">
      <div class="flex gap-2">
        <input type="text" name="search" value="<%= locals.search || '' %>"
          placeholder="Поиск по имени, email..."
          class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
        />
        <button type="submit" id="search-submit" name="search-submit"
          class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors border border-gray-300">
          Поиск
        </button>
        <% if (locals.search) { %>
          <a href="/warehouse/users"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors border border-gray-300 no-underline">
            Сбросить
          </a>
        <% } %>
      </div>
    </form>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Имя</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Email</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Роль</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Статус</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Действия</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">
                <% if (locals.search) { %>
                  Ничего не найдено по запросу «<%= search %>»
                <% } else { %>
                  Нет сотрудников. <a href="/warehouse/users/create" class="text-blue-600 hover:text-blue-800">Добавьте первого</a>.
                <% } %>
              </td>
            </tr>
          <% } %>
          <% users.forEach(function(u) { %>
            <tr class="border-b hover:bg-gray-50">
              <td class="px-4 py-2">
                <span class="text-gray-900 font-medium"><%= u.displayName || u.userName %></span>
                <% if (u.displayName) { %>
                  <span class="text-gray-400 text-xs ml-1">@<%= u.userName %></span>
                <% } %>
              </td>
              <td class="px-4 py-2 text-gray-700"><%= u.email %></td>
              <td class="px-4 py-2">
                <span class="inline-block text-xs font-medium px-2 py-0.5 rounded
                  <%= u.role === 'ADMIN' ? 'bg-red-50 text-red-700' : u.role === 'MANAGER' ? 'bg-yellow-50 text-yellow-700' : 'bg-green-50 text-green-700' %>">
                  <%= { ADMIN: 'Админ', MANAGER: 'Менеджер', EMPLOYEE: 'Сотрудник' }[u.role] || u.role %>
                </span>
              </td>
              <td class="px-4 py-2">
                <% if (u.isDeactivated) { %>
                  <span class="inline-block text-xs font-medium px-2 py-0.5 rounded bg-red-50 text-red-600">Деактивирован</span>
                <% } else { %>
                  <span class="inline-block text-xs font-medium px-2 py-0.5 rounded bg-green-50 text-green-600">Активен</span>
                <% } %>
              </td>
              <td class="px-4 py-2 text-right">
                <a href="/warehouse/users/<%= u.id %>/edit"
                   class="text-blue-600 hover:text-blue-800 text-xs mr-2">Редактировать</a>
                <% if (u.isDeactivated) { %>
                  <form action="/warehouse/users/<%= u.id %>/reactivate" method="POST" novalidate class="inline m-0">
                    <button type="submit" name="reactivate-user" class="reactivate-btn text-green-500 hover:text-green-700 text-xs">Активировать</button>
                  </form>
                <% } else { %>
                  <form action="/warehouse/users/<%= u.id %>/deactivate" method="POST" novalidate class="inline m-0"
                        onsubmit="return confirm('Деактивировать пользователя?')">
                    <button type="submit" name="deactivate-user" class="deactivate-btn text-red-500 hover:text-red-700 text-xs">Деактивировать</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
