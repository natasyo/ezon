<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include('../partials/header') %>

  <main class="flex-1 max-w-lg mx-auto px-4 py-12 w-full">
    <h2 class="text-2xl font-bold text-gray-800 mb-2">Мой профиль</h2>
    <p class="text-sm text-gray-500 mb-6">
      Роль:
      <span class="inline-block text-xs font-medium px-2 py-0.5 rounded
        <%= employee.role === 'ADMIN' ? 'bg-red-50 text-red-700' : employee.role === 'MANAGER' ? 'bg-yellow-50 text-yellow-700' : 'bg-green-50 text-green-700' %>">
        <%= { ADMIN: 'Администратор', MANAGER: 'Менеджер', EMPLOYEE: 'Сотрудник' }[employee.role] || employee.role %>
      </span>
      <% if (employee.isDeactivated) { %>
        <span class="inline-block text-xs font-medium px-2 py-0.5 rounded bg-gray-100 text-gray-500 ml-1">
          Деактивирован
        </span>
      <% } %>
    </p>

    <% if (locals.success) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
        <%= success %>
      </div>
    <% } %>

    <% if (locals.error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/warehouse/profile" method="POST" class="bg-white shadow rounded-lg p-6 space-y-4">
      <div>
        <label for="userName" class="block text-sm font-medium text-gray-700 mb-1">Имя пользователя</label>
        <input type="text" id="userName" name="userName" required
          value="<%= employee.userName %>"
          minlength="3" maxlength="30"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none<%= locals.errors && errors.userName ? ' border-red-400' : '' %>"
        />
        <% if (locals.errors && errors.userName) { %>
          <p class="text-red-500 text-xs mt-1"><%= errors.userName %></p>
        <% } %>
      </div>
      <div>
        <label for="displayName" class="block text-sm font-medium text-gray-700 mb-1">Отображаемое имя</label>
        <input type="text" id="displayName" name="displayName"
          value="<%= employee.displayName || '' %>"
          maxlength="100"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" id="email" name="email" required
          value="<%= employee.email %>"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none<%= locals.errors && errors.email ? ' border-red-400' : '' %>"
        />
        <% if (locals.errors && errors.email) { %>
          <p class="text-red-500 text-xs mt-1"><%= errors.email %></p>
        <% } %>
      </div>

      <hr class="border-gray-200">

      <p class="text-xs text-gray-400">Заполните только если хотите сменить пароль</p>
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Новый пароль</label>
        <input type="password" id="password" name="password"
          minlength="6" maxlength="100"
          placeholder="Оставьте пустым, чтобы не менять"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
        />
      </div>
      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Подтверждение пароля</label>
        <input type="password" id="confirmPassword" name="confirmPassword"
          minlength="6" maxlength="100"
          placeholder="Повторите новый пароль"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
        />
      </div>

      <button type="submit" id="profile-submit" name="profile-submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 rounded-lg transition-colors">
        Сохранить изменения
      </button>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-200">
      <% if (employee.isDeactivated) { %>
        <p class="text-sm text-gray-500 mb-3">Профиль деактивирован. Вы можете восстановить его.</p>
        <form action="/warehouse/profile/reactivate" method="POST">
          <button type="submit"
            class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2 rounded-lg transition-colors">
            Восстановить профиль
          </button>
        </form>
      <% } else { %>
        <p class="text-sm text-gray-500 mb-3">Деактивация временно заблокирует доступ к аккаунту.</p>
        <form action="/warehouse/profile/deactivate" method="POST"
          onsubmit="return confirm('Вы уверены? Доступ к аккаунту будет заблокирован.')">
          <button type="submit" id="profile-deactivate" data-email="<%= employee.email %>"
            class="w-full bg-red-600 hover:bg-red-700 text-white font-medium py-2 rounded-lg transition-colors">
            Деактивировать профиль
          </button>
        </form>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>
