generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Статусы товара ---
enum ProductStatus {
  ARRIVAL     // Поступление
  IN_STOCK    // На складе
  PLACED      // Размещён
  SOLD        // Продан
  WRITTEN_OFF // Списан
}

// --- Статус на витрине ---
enum ShowcaseStatus {
  VISIBLE
  HIDDEN
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String
  userName    String  @unique
  displayName String? @map("display_name")

  isDeactivated Boolean   @default(false)
  deactivatedAt DateTime?

  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  // --- Идентификаторы (защищены от изменения) ---
  id  String   @id  @default(uuid())
  sku  String @unique
  ean  String?
  asin String?

  // --- Карточка ---
  name     String
  category String?
  condition String?

  // --- Цены ---
  purchasePrice Decimal @default(0) @map("purchase_price")
  salePrice     Decimal @default(0) @map("sale_price")

  // --- Статус ---
  status ProductStatus @default(ARRIVAL)

  // --- Склад ---
  cell String?

  // --- Витрины ---
  showcaseStatuses Json @default("{}") @map("showcase_statuses")

  // --- Даты ---
  arrivalDate DateTime? @map("arrival_date")

  // --- Фотографии (ключи S3) ---
  images String[]

  // --- Дополнительные поля ---
  customFields Json @default("{}") @map("custom_fields")

  // --- Мета ---
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Индексы ---
  @@index([name])
  @@index([sku])
  @@index([ean])
  @@index([category])
  @@index([status])
  @@index([cell])

  @@map("products")
}
